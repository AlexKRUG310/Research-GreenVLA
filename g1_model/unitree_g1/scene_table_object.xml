<mujoco model="g1_scene_table_object">
  <include file="g1_with_hands.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.6 0.4 0.2 1"/>
    <material name="cube_mat" rgba="1.0 0.9 0.2 1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Стол перед роботом -->
    <body name="table" pos="0.6 0 0.8">
      <geom name="table_top" type="box" size="0.5 0.6 0.02" material="table_mat" contype="1" conaffinity="1" friction="1 0.5 0.5"/>
      <geom name="table_leg1" type="cylinder" fromto="-0.35 -0.25 -0.8 -0.35 -0.25 0" size="0.02" material="table_mat"/>
      <geom name="table_leg2" type="cylinder" fromto="-0.35 0.25 -0.8 -0.35 0.25 0" size="0.02" material="table_mat"/>
      <geom name="table_leg3" type="cylinder" fromto="0.35 -0.25 -0.8 0.35 -0.25 0" size="0.02" material="table_mat"/>
      <geom name="table_leg4" type="cylinder" fromto="0.35 0.25 -0.8 0.35 0.25 0" size="0.02" material="table_mat"/>
    </body>
    
    <!-- Желтые кубики на столе -->
    <body name="small_yellow_cube" pos="0.45 -0.1 0.85">
      <joint name="small_cube_slide_x" type="slide" axis="1 0 0" damping="0.1"/>
      <joint name="small_cube_slide_y" type="slide" axis="0 1 0" damping="0.1"/>
      <joint name="small_cube_slide_z" type="slide" axis="0 0 1" damping="0.1"/>
      <geom name="smaall_cube_geom" type="box" size="0.02 0.02 0.02" material="cube_mat" mass="0.05" 
            contype="1" conaffinity="1" friction="1 0.5 0.5" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    </body>
   
    <body name="yellow_cube" pos="0.45 0.07 0.85">
      <joint name="cube_slide_x" type="slide" axis="1 0 0" damping="0.1"/>
      <joint name="cube_slide_y" type="slide" axis="0 1 0" damping="0.1"/>
      <joint name="cube_slide_z" type="slide" axis="0 0 1" damping="0.1"/>
      <geom name="cube_geom" type="box" size="0.03 0.03 0.03" material="cube_mat" mass="0.05" 
            contype="1" conaffinity="1" friction="1 0.5 0.5" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    </body>        
  </worldbody>
</mujoco>
